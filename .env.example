require('dotenv').config();
const express = require('express');
const path = require('path');

const app = express();
const PORT = process.env.PORT || 4173;
const OPENAI_API_KEY = process.env.OPENAI_API_KEY;
const OPENAI_MODEL = process.env.OPENAI_MODEL || 'gpt-4o-mini';

app.use(express.json({ limit: '1mb' }));

function getProjectResponseFromContent(content) {
  const match = content.match(/```json\s*([\s\S]*?)\s*```/i) || content.match(/\{[\s\S]*\}/);
  const jsonString = match ? (match[1] || match[0]) : content;
  const parsed = JSON.parse(jsonString);

  if (!parsed.html || !parsed.css || !parsed.js) {
    throw new Error('AI response did not include html, css, and js fields.');
  }

  return {
    html: String(parsed.html),
    css: String(parsed.css),
    js: String(parsed.js),
  };
}

app.get('/api/health', (req, res) => {
  res.json({
    status: 'ok',
    aiConfigured: Boolean(OPENAI_API_KEY),
    model: OPENAI_API_KEY ? OPENAI_MODEL : 'not-configured',
  });
});

app.post('/api/generate', async (req, res) => {
  const { prompt } = req.body || {};

  if (!prompt || !String(prompt).trim()) {
    return res.status(400).json({ error: 'A website description is required.' });
  }

  if (!OPENAI_API_KEY) {
    return res.status(503).json({
      error: 'No AI model is configured on the backend. Add OPENAI_API_KEY to your environment to enable generation.',
    });
  }

  try {
    const response = await fetch('https://api.openai.com/v1/chat/completions', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        Authorization: `Bearer ${OPENAI_API_KEY}`,
      },
      body: JSON.stringify({
        model: OPENAI_MODEL,
        temperature: 0.7,
        response_format: { type: 'json_object' },
        messages: [
          {
            role: 'system',
            content:
              'You are a senior frontend engineer. Generate a complete responsive landing page or app in HTML, CSS, and JavaScript. Return only valid JSON with keys html, css, and js. The html should contain semantic markup and content matching the user request. The css should include modern styling and responsive behavior. The js should include interactive behavior where helpful. Do not include markdown fences or extra commentary.',
          },
          {
            role: 'user',
            content: `Create a modern website or web app for this idea: ${prompt}`,
          },
        ],
      }),
    });

    const data = await response.json();

    if (!response.ok) {
      const message = data?.error?.message || 'The AI provider rejected the request.';
      return res.status(500).json({ error: message });
    }

    const rawText = data?.choices?.[0]?.message?.content;

    if (!rawText) {
      return res.status(500).json({ error: 'The model returned no usable content.' });
    }

    const project = getProjectResponseFromContent(rawText);

    return res.json({ project });
  } catch (error) {
    console.error('AI generation error:', error);
    return res.status(500).json({
      error: 'AI generation failed. Check the server logs and backend configuration.',
    });
  }
});

app.use(express.static(path.join(__dirname, '.')));

app.get('*', (req, res) => {
  if (req.path.startsWith('/api/')) {
    return res.status(404).json({ error: 'Route not found.' });
  }

  res.sendFile(path.join(__dirname, 'index.html'));
});

app.listen(PORT, () => {
  console.log(`ForgeAI server running on http://localhost:${PORT}`);
  if (!OPENAI_API_KEY) {
    console.log('AI is disabled because OPENAI_API_KEY is not set.');
  }
});
